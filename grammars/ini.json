{
  "name": "INI",
  "scopeName": "source.ini",
  "type": "tree-sitter",
  "parser": "tree-sitter-ini",
  "injectionNames": ["ini"],
  // `npmrc` is npm's own config, which npm reads with the `ini` package. It
  // used to be claimed by language-shellscript, where a `;` comment is a
  // command separator and every comment tokenized as shell.
  "fileTypes": ["ini", "cfg", "conf", "desktop", "editorconfig", "inf", "npmrc", "prefs"],
  "comments": {
    "start": "; "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:justinmk/tree-sitter-ini#v1.4.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "ini.wasm",
    "highlightsQuery": "ini-highlights.scm",
    "foldsQuery": "ini-folds.scm",
    // No indents query: INI sections do not nest, so there is nothing to
    // indent and a rule here would only fight the user.
    "tagsQuery": "ini-tags.scm"
  }
}
